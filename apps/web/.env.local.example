# Fixed deployment config — copy as-is.
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HOME_DOMAIN=localhost:3000
NEXT_PUBLIC_PRICE_NGN=525
NEXT_PUBLIC_PRICE_USDC=0.39
NEXT_PUBLIC_MIN_SHARES=10
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Filled in by POST /api/admin/bootstrap (or `pnpm --dir scripts print-env`) —
# leave blank, run the app, log into /admin, press "Run bootstrap", then copy
# the response's addresses in here and restart.
NEXT_PUBLIC_DPRI_ISSUER=
NEXT_PUBLIC_DPRI_SAC=
NEXT_PUBLIC_USDC_ISSUER=
NEXT_PUBLIC_USDC_SAC=
NEXT_PUBLIC_OFFER_CONTRACT=
NEXT_PUBLIC_ADMIN_PUBLIC=
NEXT_PUBLIC_DEMO_CLOSE_LEDGER=

# Server-only secrets. Get a fresh Stellar keypair + random string from
# GET /api/admin/new-secret (no CLI needed) — one call per line below.
ISSUER_SECRET=
ADMIN_SECRET=
SERVER_SIGNING_SECRET=
JWT_SECRET=
ADMIN_UI_PASSWORD=
USE_MOCK_USDC=false
# Only needed if USE_MOCK_USDC=true.
MOCK_USDC_ISSUER_SECRET=
